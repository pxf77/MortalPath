; Engine configuration file.
; Edit through the Godot editor when possible.
config_version=5

[application]

config/name="MortalPath"
run/main_scene="res://src/main/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.027, 0.031, 0.043, 1)

[autoload]

InputBootstrap="*res://src/core/input_bootstrap.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.027, 0.031, 0.043, 1)
